static void glw_build_corner_grid(osrs_gl_world_t *gw, osrs_config_t *config,
                                  osrs_region_t *region, int plane,
                                  osrs_region_t *adj_n, osrs_region_t *adj_e,
                                  osrs_region_t *adj_s, osrs_region_t *adj_w,
                                  int heights[GLW_CORNER_N][GLW_CORNER_N],
                                  uint32_t colors[GLW_CORNER_N][GLW_CORNER_N]) {
  /* Heights: corner (cx,cz) takes the tile height from the appropriate
   * region. For edge corners, look up adjacent regions to avoid seams. */
  for (int cz = 0; cz < GLW_CORNER_N; cz++) {
    for (int cx = 0; cx < GLW_CORNER_N; cx++) {
      osrs_tile_t *tile = glw_get_adjacent_tile(
          adj_n, adj_e, adj_s, adj_w, region, cx, cz, plane);
      if (tile)
        heights[cz][cx] = tile->height;
      else
        heights[cz][cx] = region->tiles[plane]
                           [cx < OSRS_REGION_SIZE ? cx : OSRS_REGION_SIZE - 1]
                           [cz < OSRS_REGION_SIZE ? cz : OSRS_REGION_SIZE - 1]
                               .height;
    }
  }

  /* Underlay colors: corner (cx,cz) blends the underlay defs of the up-to-4
   * tiles touching that corner (deob Scene algorithm):
   *   hue/mult are summed, then avgHue = hueSum/multSum,
   *   avgSat = satSum/count, avgLight = lightSum/count.
   * For edge corners, look up adjacent regions so colors match across
   * region boundaries. */
  for (int cz = 0; cz < GLW_CORNER_N; cz++) {
    for (int cx = 0; cx < GLW_CORNER_N; cx++) {
      int hue_sum = 0, sat_sum = 0, light_sum = 0, count = 0;
      for (int dz = -1; dz <= 0; dz++) {
        for (int dx = -1; dx <= 0; dx++) {
          int tx = cx + dx;
          int tz = cz + dz;
          osrs_tile_t *tile = glw_get_adjacent_tile(
              adj_n, adj_e, adj_s, adj_w, region, tx, tz, plane);
          if (!tile)
            continue;
          int uid = tile->underlay_id;
          if (uid <= 0)
            continue;
          int h, s, l, m;
          if (!glw_underlay_hsl(gw, config, uid - 1, &h, &s, &l, &m))
            continue;
          /* Per-tile hue normalized to 0-255 (MapImageDumper formula):
           * def.hue = mult * hue_frac, so hue*256/mult = frac*256. */
          hue_sum += h * 256 / m;
          sat_sum += s;
          light_sum += l;
          count++;
        }
      }
      if (count == 0) {
        colors[cz][cx] = 0xFF000000; /* no underlay: black */
      } else {
        int avg_hue = hue_sum / count;
        int avg_sat = sat_sum / count;
        int avg_light = light_sum / count;
        colors[cz][cx] = osrs_hsl_full_to_rgb(avg_hue, avg_sat, avg_light);
      }
    }
  }
}

/* Overlay shape geometry on a 4x4 sub-grid (positions 0,1/3,2/3,1).
 * Paths 0-3 are exact (full, diagonal half, three-quarter, quarter);
 * rarer paths 4-11 approximate to full tile (documented limitation).
 * Each entry: vertex grid indices (gx + gz*4), fan-triangulated. */
typedef struct {
  int count;
  int idx[8];
} glw_shape_t;
